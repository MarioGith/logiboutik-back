# Port the API listens on (default 3020)
API_PORT=3020
# MongoDB connection string (default mongodb://mongo/boutikdac, the docker-compose service)
MONGO_URL=mongodb://localhost:27017/boutikdac
# Origins allowed to call the API from a browser, comma-separated (default http://localhost:3000)
CORS_ORIGIN=http://localhost:3000
# Only for `pnpm test`: a THROWAWAY database used by the API tests (wiped on every test)
# MONGO_URL_TEST=mongodb://localhost:27018/logiboutik-test
