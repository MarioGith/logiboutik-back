{
  "name": "logiboutik-back",
  "version": "1.1.0",
  "description": "Logiboutik REST API (Express + MongoDB)",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "concurrently \"tsc --watch\" \"nodemon -q dist/index.js\"",
    "start": "node dist/index.js",
    "migrate": "node dist/scripts/migrate.js",
    "restore": "node dist/scripts/restore.js",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint ./src ./tests --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky"
  },
  "author": "Itsemi",
  "license": "ISC",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "mongoose": "^5.13.23"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.ts": "prettier --write"
  }
}
